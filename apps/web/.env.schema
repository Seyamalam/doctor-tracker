# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url @optional
# Empty/unset means same-origin /api (Vercel routes it to the API service).
NEXT_PUBLIC_SERVER_URL=

# @public @type=url @optional
# Canonical public origin for metadataBase / og:url (falls back to a default).
NEXT_PUBLIC_APP_URL=
