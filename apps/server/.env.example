NODE_ENV=development
BETTER_AUTH_SECRET=replace-with-a-random-32+-char-secret
# Local dev: API origin. On Vercel: the public site URL, e.g. https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Local dev: web origin. On Vercel: same public site URL (better-auth trustedOrigins).
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor_tracker?retryWrites=true&w=majority
