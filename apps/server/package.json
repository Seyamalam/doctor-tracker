{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@doctor-tracker/api": "*",
    "@doctor-tracker/auth": "*",
    "@doctor-tracker/db": "*",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "^11.28.0",
    "better-auth": "1.7.22",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mongoose": "^9.12.1",
    "varlock": "1.25.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@doctor-tracker/config": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
