{
  "name": "doctor-tracker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "dev:server": "vp run --filter server dev",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@doctor-tracker/config": "*",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "rolldown": "1.3.2",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "varlock": "1.25.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@2.0.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "packageManager": "npm@11.20.0",
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
